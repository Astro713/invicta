Options -Indexes

RewriteEngine On

# Use one canonical homepage URL instead of serving / and /index.php separately.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ https://www.invictacanecorso.com/ [R=301,L,NE]

# Consolidate HTTP and non-www requests into the public www HTTPS hostname.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.invictacanecorso\.com$ [NC]
RewriteRule ^ https://www.invictacanecorso.com%{REQUEST_URI} [R=301,L,NE]

<FilesMatch "(^_config|\.toml$)">
  Require all denied
</FilesMatch>
